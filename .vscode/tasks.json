{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "VKSound: Test",
      "type": "shell",
      "command": "npm test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "VKSound: Start",
      "type": "shell",
      "command": "npm start",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "VKSound: Build Windows Installer",
      "type": "shell",
      "command": ".\\Build-App.cmd",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
